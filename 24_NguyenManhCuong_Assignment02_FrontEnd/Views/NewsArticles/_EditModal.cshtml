@model _24_NguyenManhCuong_Assignment02_FrontEnd.Models.NewsArticleViewModel
@{
    var allTags = ViewBag.AllTags as List<_24_NguyenManhCuong_Assignment02_FrontEnd.Models.TagViewModel> ?? new();
    var selectedTagIds = ViewBag.SelectedTagIds as List<int> ?? Model.SelectedTagIds ?? new();
}

<div class="modal-header border-0 pb-0">
    <div class="d-flex align-items-center gap-3">
        <div class="bg-warning bg-opacity-10 rounded-3 p-2">
            <i class="bi bi-newspaper text-warning fs-4"></i>
        </div>
        <div>
            <h5 class="modal-title fw-bold mb-0">Edit Article</h5>
            <p class="text-muted small mb-0">ID: <code class="text-dark">@Model.NewsArticleID</code></p>
        </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form id="editArticleForm" asp-action="EditModal" asp-route-id="@Model.NewsArticleID" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="NewsArticleID" />
    <input type="hidden" asp-for="CreatedByID" />
    <div class="modal-body px-4 py-3" style="max-height: 65vh; overflow-y: auto;">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

        <div class="row g-3">
            <div class="col-md-5">
                <label class="form-label small fw-semibold text-secondary">Article ID</label>
                <input value="@Model.NewsArticleID" class="form-control form-control-sm font-monospace bg-light" readonly />
            </div>
            <div class="col-md-7">
                <label asp-for="CategoryID" class="form-label small fw-semibold text-secondary"></label>
                <select asp-for="CategoryID" class="form-select form-select-sm" asp-items="ViewBag.CategoryID">
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="CategoryID" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Headline" class="form-label small fw-semibold text-secondary"></label>
                <input asp-for="Headline" class="form-control form-control-sm" />
                <span asp-validation-for="Headline" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="NewsTitle" class="form-label small fw-semibold text-secondary"></label>
                <input asp-for="NewsTitle" class="form-control form-control-sm" />
            </div>

            <div class="col-md-8">
                <label asp-for="NewsSource" class="form-label small fw-semibold text-secondary"></label>
                <input asp-for="NewsSource" class="form-control form-control-sm" />
            </div>
            <div class="col-md-4 d-flex align-items-center pt-2">
                <div class="form-check form-switch">
                    <input asp-for="NewsStatus" class="form-check-input" type="checkbox" id="editNewsStatus" />
                    <label class="form-check-label small fw-semibold" for="editNewsStatus">Published</label>
                </div>
            </div>

            <div class="col-12">
                <label asp-for="NewsContent" class="form-label small fw-semibold text-secondary"></label>
                <textarea asp-for="NewsContent" class="form-control form-control-sm" rows="5"></textarea>
                <span asp-validation-for="NewsContent" class="text-danger small"></span>
            </div>

            <!-- Tags -->
            <div class="col-12">
                <label class="form-label small fw-semibold text-secondary d-block">Assign Tags</label>
                <div class="d-flex flex-wrap gap-2 p-3 bg-light rounded-3 border">
                    @if (allTags.Any())
                    {
                        foreach (var tag in allTags)
                        {
                            var isChecked = selectedTagIds.Contains(tag.TagID);
                            <div class="form-check form-check-inline m-0">
                                <input class="form-check-input" type="checkbox" name="SelectedTagIds"
                                       value="@tag.TagID" id="etag_@tag.TagID" @(isChecked ? "checked" : "") />
                                <label class="form-check-label small" for="etag_@tag.TagID">#@tag.TagName</label>
                            </div>
                        }
                    }
                    else
                    {
                        <span class="text-muted small">No tags available.</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-lg me-1"></i>Cancel
        </button>
        <button type="submit" class="btn btn-warning px-4 text-dark">
            <i class="bi bi-save me-1"></i>Save Changes
        </button>
    </div>
</form>
