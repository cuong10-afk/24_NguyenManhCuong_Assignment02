@model IEnumerable<_24_NguyenManhCuong_Assignment02_FrontEnd.Models.CategoryViewModel>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-tags-fill text-primary me-2"></i>Category Management</h2>
        <p class="text-muted small mb-0">Organize articles into hierarchical news categories</p>
    </div>
    <button type="button" class="btn btn-primary shadow-sm" onclick="openCreateModal()">
        <i class="bi bi-folder-plus me-1"></i>Add New Category
    </button>
</div>

<!-- Search Bar -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Search by name or description..." />
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-secondary">Search</button>
                @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch as string))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary ms-1">Reset</a>
                }
            </div>
            <div class="col-auto ms-auto">
                <span class="text-muted small">Total: <strong>@(Model?.Count() ?? 0)</strong> categories</span>
            </div>
        </form>
    </div>
</div>

<!-- Categories Table -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 80px;">ID</th>
                    <th scope="col">Category Name</th>
                    <th scope="col">Description</th>
                    <th scope="col">Parent Category</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end" style="width: 160px;">Actions</th>
                </tr>
            </thead>
            <tbody id="categoriesTableBody">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr id="category-row-@item.CategoryID">
                            <td><span class="badge bg-secondary-subtle text-secondary">#@item.CategoryID</span></td>
                            <td class="fw-semibold">@item.CategoryName</td>
                            <td class="text-muted small" style="max-width: 300px;">
                                <span title="@item.CategoryDesciption">
                                    @(item.CategoryDesciption?.Length > 80 ? item.CategoryDesciption[..80] + "…" : item.CategoryDesciption)
                                </span>
                            </td>
                            <td>
                                @if (item.ParentCategory != null)
                                {
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-arrow-return-right me-1"></i>@item.ParentCategory.CategoryName
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small"><em>None (Root)</em></span>
                                }
                            </td>
                            <td>
                                @if (item.IsActive == true)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle me-1"></i>Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                        <i class="bi bi-x-circle me-1"></i>Inactive
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-outline-primary btn-sm me-1" title="Edit"
                                        onclick="openEditModal(@item.CategoryID)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-outline-danger btn-sm" title="Delete"
                                        onclick="confirmDelete(@item.CategoryID, '@Html.Raw(item.CategoryName?.Replace("'", "\\'"))')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-folder2-open fs-2 d-block mb-2"></i>
                            No categories found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- === MODAL: Create Category === -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div id="createCategoryModalContent"><!-- AJAX --></div>
        </div>
    </div>
</div>

<!-- === MODAL: Edit Category === -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div id="editCategoryModalContent"><!-- AJAX --></div>
        </div>
    </div>
</div>

<!-- === MODAL: Delete Confirm === -->
<div class="modal fade" id="deleteCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-danger bg-opacity-10 rounded-3 p-2">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                    </div>
                    <h6 class="modal-title fw-bold mb-0">Confirm Delete</h6>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <p class="mb-0 small">Are you sure you want to delete category <strong id="deleteCategoryName"></strong>?</p>
                <p class="small text-danger mt-1 mb-0"><i class="bi bi-info-circle me-1"></i>Cannot delete if linked to news articles.</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteCategoryForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm px-3">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function openCreateModal() {
            fetch('@Url.Action("CreateModal", "Categories")')
                .then(r => r.text())
                .then(html => {
                    document.getElementById('createCategoryModalContent').innerHTML = html;
                    bindCreateForm();
                    new bootstrap.Modal(document.getElementById('createCategoryModal')).show();
                });
        }

        function bindCreateForm() {
            const form = document.getElementById('createCategoryForm');
            if (!form) return;
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                submitModalForm(form, 'createCategoryModal', 'createCategoryModalContent', bindCreateForm);
            });
        }

        function openEditModal(id) {
            fetch('@Url.Action("EditModal", "Categories")/' + id)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('editCategoryModalContent').innerHTML = html;
                    bindEditForm(id);
                    new bootstrap.Modal(document.getElementById('editCategoryModal')).show();
                });
        }

        function bindEditForm(id) {
            const form = document.getElementById('editCategoryForm');
            if (!form) return;
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                submitModalForm(form, 'editCategoryModal', 'editCategoryModalContent', () => bindEditForm(id));
            });
        }

        function confirmDelete(id, name) {
            document.getElementById('deleteCategoryName').textContent = name;
            const form = document.getElementById('deleteCategoryForm');
            form.action = '@Url.Action("DeleteAjax", "Categories")/' + id;
            form.onsubmit = function (e) {
                e.preventDefault();
                const fd = new FormData(form);
                fetch(form.action, { method: 'POST', body: fd })
                    .then(r => r.json())
                    .then(data => {
                        bootstrap.Modal.getInstance(document.getElementById('deleteCategoryModal')).hide();
                        if (data.success) {
                            showToast(data.message, 'success');
                            setTimeout(() => location.reload(), 900);
                        } else {
                            showToast(data.message, 'danger');
                        }
                    });
            };
            new bootstrap.Modal(document.getElementById('deleteCategoryModal')).show();
        }

        function submitModalForm(form, modalId, contentId, rebindFn) {
            const fd = new FormData(form);
            fetch(form.action, { method: 'POST', body: fd })
                .then(r => {
                    const ct = r.headers.get('content-type') || '';
                    if (ct.includes('application/json')) return r.json().then(data => ({ type: 'json', data }));
                    return r.text().then(html => ({ type: 'html', html }));
                })
                .then(result => {
                    if (result.type === 'json') {
                        if (result.data.success) {
                            bootstrap.Modal.getInstance(document.getElementById(modalId)).hide();
                            showToast(result.data.message, 'success');
                            setTimeout(() => location.reload(), 900);
                        } else {
                            showToast(result.data.message || 'Operation failed.', 'danger');
                        }
                    } else {
                        document.getElementById(contentId).innerHTML = result.html;
                        rebindFn();
                    }
                });
        }

        function showToast(message, type) {
            const id = 'toast-' + Date.now();
            const html = `<div id="${id}" class="toast align-items-center text-bg-${type} border-0 show" role="alert" style="min-width:280px">
                <div class="d-flex"><div class="toast-body fw-semibold">${message}</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>`;
            let c = document.getElementById('toastContainer');
            if (!c) {
                c = document.createElement('div');
                c.id = 'toastContainer';
                c.className = 'toast-container position-fixed bottom-0 end-0 p-3';
                c.style.zIndex = '9999';
                document.body.appendChild(c);
            }
            c.insertAdjacentHTML('beforeend', html);
            setTimeout(() => document.getElementById(id)?.remove(), 4000);
        }
    </script>
}
