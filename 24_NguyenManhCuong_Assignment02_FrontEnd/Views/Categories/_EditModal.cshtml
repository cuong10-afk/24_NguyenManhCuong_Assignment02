@model _24_NguyenManhCuong_Assignment02_FrontEnd.Models.CategoryViewModel

<div class="modal-header border-0 pb-0">
    <div class="d-flex align-items-center gap-3">
        <div class="bg-warning bg-opacity-10 rounded-3 p-2">
            <i class="bi bi-folder2-open text-warning fs-4"></i>
        </div>
        <div>
            <h5 class="modal-title fw-bold mb-0">Edit Category #@Model.CategoryID</h5>
            <p class="text-muted small mb-0">Update category information</p>
        </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form id="editCategoryForm" asp-action="EditModal" asp-route-id="@Model.CategoryID" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CategoryID" />
    <div class="modal-body px-4 py-3">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label small fw-semibold text-secondary"></label>
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-folder"></i></span>
                <input asp-for="CategoryName" class="form-control" />
            </div>
            <span asp-validation-for="CategoryName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryDesciption" class="form-label small fw-semibold text-secondary"></label>
            <textarea asp-for="CategoryDesciption" class="form-control" rows="3"></textarea>
            <span asp-validation-for="CategoryDesciption" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ParentCategoryID" class="form-label small fw-semibold text-secondary"></label>
            <select asp-for="ParentCategoryID" asp-items="ViewBag.ParentCategoryID" class="form-select">
                <option value="">-- None (Root Category) --</option>
            </select>
        </div>

        <div class="mb-3">
            <div class="form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="editIsActive" />
                <label class="form-check-label fw-semibold small" for="editIsActive">Active Category</label>
            </div>
        </div>
    </div>

    <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-lg me-1"></i>Cancel
        </button>
        <button type="submit" class="btn btn-warning px-4 text-dark">
            <i class="bi bi-save me-1"></i>Save Changes
        </button>
    </div>
</form>
